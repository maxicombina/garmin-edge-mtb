<settings>
    <!-- Settings UI shown in Garmin Connect Mobile / Garmin Express (SPEC 7). Data fields
         cannot be configured on-device; document this in the store description. -->

    <setting propertyKey="@Properties.vamWindowSec" title="@Strings.SetVamWindow">
        <settingConfig type="list">
            <listEntry value="5">@Strings.Sec5</listEntry>
            <listEntry value="10">@Strings.Sec10</listEntry>
            <listEntry value="30">@Strings.Sec30</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.gradeWindowM" title="@Strings.SetGradeWindow">
        <settingConfig type="list">
            <listEntry value="10">@Strings.Met10</listEntry>
            <listEntry value="15">@Strings.Met15</listEntry>
            <listEntry value="20">@Strings.Met20</listEntry>
            <listEntry value="30">@Strings.Met30</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.primaryMetric" title="@Strings.SetPrimaryMetric">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OrderGradeFirst</listEntry>
            <listEntry value="1">@Strings.OrderVamFirst</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.colorZones" title="@Strings.SetColorZones">
        <settingConfig type="boolean" />
    </setting>
</settings>
