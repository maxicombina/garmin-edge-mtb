<?xml version="1.0"?>
<!--
  Connect IQ manifest for the j-trend-arrow data field (Option J).

  THIS IS THE PRODUCTION SIDE. This id is J's PROD id and it lives ONLY on the
  release branch; main carries the BETA id f70f3c984e4c43d496006628f3510817 instead.
  Each id is a separate app in the store: this is the published one (v0.1.0, then
  v0.2.2). The beta id exists because app settings CANNOT be configured from the
  phone for a sideloaded app, so testing them needs a real store install, and doing
  that against the live listing would mean a review round per iteration.

  THIS LINE IS THE ONLY DELTA of release over main for this app, and it is why every
  "git merge main" carries the BETA id in here with NO conflict (only main changed it
  last). That happened at v0.2.2 and was swapped back in the very next commit. So,
  at EVERY future release: merge, then CHECK THIS LINE before exporting the .iq. A
  wrong id builds and signs perfectly and uploads to the wrong app.

  NEVER edit this id with the visual manifest editor (it reformats the XML). Edit by
  hand.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="140986d8c6bc4026880e117255a6ce67"
        type="datafield"
        name="@Strings.AppName"
        entry="TrendArrowApp"
        minApiLevel="3.3.0"
        launcherIcon="@Drawables.LauncherIcon">
        <iq:products>
            <iq:product id="edge530"/>
            <iq:product id="edge540"/>
            <iq:product id="edge830"/>
            <iq:product id="edge840"/>
            <iq:product id="edge550"/>
            <iq:product id="edge850"/>
            <iq:product id="edge1030"/>
            <iq:product id="edge1030bontrager"/>
            <iq:product id="edge1030plus"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>spa</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="TrendCore" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
