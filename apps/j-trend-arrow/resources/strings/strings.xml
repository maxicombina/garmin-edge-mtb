<strings>
    <!-- English is the base / fallback language (like A and B). -->
    <string id="AppName">Speed Trend</string>

    <!-- Field label drawn above the current value (uppercased at runtime). Metric NAME only:
         the unit is drawn next to the number, native style. Two variants, like the native
         field: the long name is used when it fits the cell width, else the short one. -->
    <string id="SpeedLabel">Speed</string>
    <string id="SpeedLabelShort">Speed</string>

    <!-- Prefix drawn before the average value on the secondary line (uppercased). -->
    <string id="AvgLabel">Avg</string>

    <!-- App settings, edited from the phone (SPEC 9). -->
    <string id="SetReference">Compare against</string>
    <string id="RefAverage">Ride average</string>
    <string id="RefTarget">Fixed target</string>
    <string id="SetTargetSpeed">Target speed, 1 decimal (in your device speed unit, km/h or mph)</string>

    <!-- Prefix of the secondary line when comparing against the fixed target, instead of
         AvgLabel (uppercased at runtime like the other labels). -->
    <string id="TargetLabel">Goal</string>
</strings>
