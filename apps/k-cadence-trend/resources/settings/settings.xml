<settings>
    <!-- Edited from the phone (Garmin Connect Mobile / Connect IQ Store app) or Garmin Express. Data
         fields cannot be configured on the Edge itself: platform limit, same note as b-grade-vam and
         j-trend-arrow. Saving delivers onSettingsChanged while the field is running. -->
    <setting propertyKey="@Properties.referenceMode" title="@Strings.SetReference">
        <settingConfig type="list">
            <listEntry value="0">@Strings.RefAverage</listEntry>
            <listEntry value="1">@Strings.RefTarget</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.targetCadence" title="@Strings.SetTargetCadence">
        <!-- Whole rpm. The schema CANNOT enforce that (there is no step= and no decimals= in
             resources.xsd), so the title says so and CadenceFormat.targetRpm rounds defensively if a
             decimal ever arrives. max 220 sits above any human cadence (track sprint records are near
             200) and keeps every possible value inside the field's 3-digit width template.
             NOTE: a double hyphen is forbidden inside an XML comment; it fails the resource
             validation, not the build. Already cost this repo a round in Option B. -->
        <settingConfig type="numeric" min="0" max="220" />
    </setting>
</settings>
