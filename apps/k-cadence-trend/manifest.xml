<?xml version="1.0"?>
<!--
  Connect IQ manifest for the k-cadence-trend data field (Option K).

  THIS IS THE PRODUCTION SIDE. This id is K's PROD id and it lives ONLY on the release branch; main
  carries the BETA id 245d380378fd4d208ea89989b8b337a7 instead. Each id is a separate app in the
  store: this is the published one (v0.1.0). K went straight to production, so its beta id has never
  been used; it stays reserved in case a test channel is ever worth the review round.

  THIS LINE IS THE ONLY DELTA of release over main for this app, and it is why every "git merge main"
  carries the BETA id in here with NO conflict (only main changed it last). So, at EVERY future
  release: merge, then CHECK THIS LINE before exporting the .iq. A wrong id builds and signs
  perfectly and uploads to the wrong app.

  A data field's settings and its slot on screen belong to the APP, so cadence had to be its own app
  rather than a setting of Option J : otherwise you could not show speed and cadence at the same
  time, which is the whole point.

  Production submission uses the release-branch flow (see repo CLAUDE.md). NEVER edit this id with
  the visual manifest editor (it reformats the XML). Edit by hand.

  It depends on the TrendCore barrel for the classifier and the render engine, by SOURCE (see
  monkey.jungle) so there is no separate build step.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="ec5d354d6b804c569088bbce765472b8"
        type="datafield"
        name="@Strings.AppName"
        entry="CadenceTrendApp"
        minApiLevel="3.3.0"
        launcherIcon="@Drawables.LauncherIcon">
        <iq:products>
            <iq:product id="edge530"/>
            <iq:product id="edge540"/>
            <iq:product id="edge830"/>
            <iq:product id="edge840"/>
            <iq:product id="edge550"/>
            <iq:product id="edge850"/>
            <iq:product id="edge1030"/>
            <iq:product id="edge1030bontrager"/>
            <iq:product id="edge1030plus"/>
            <iq:product id="edge1040"/>
            <iq:product id="edge1050"/>
            <iq:product id="edgeexplore2"/>
            <iq:product id="edgemtb"/>
        </iq:products>
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>spa</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="TrendCore" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
